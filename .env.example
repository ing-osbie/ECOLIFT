# ============================================================================
# EcoLift Environment Configuration
# Copy this file to `.env` and fill in your real values.
# ============================================================================

# --- Supabase ---
# 1. Create a project at https://supabase.com
# 2. Copy the URL and anon key from Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Google Maps Platform ---
# Obtain an API key from https://console.cloud.google.com/google/maps-apis/credentials
# Used at runtime for geocoding/places/directions, and injected into the
# native iOS/Android build via app.json (${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- EAS Build (optional, for production builds) ---
# Set these in the EAS dashboard or via `eas env` rather than committing them.
# EAS_PROJECT_ID=f98fb773-e942-40e4-9207-b639ff833acd